^SAMPLE = GSM1274259
!Sample_title = Hypoxia_48hr (total RNA)_7
!Sample_geo_accession = GSM1274259
!Sample_status = Public on Oct 20 2016
!Sample_submission_date = Nov 25 2013
!Sample_last_update_date = May 15 2019
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = A2780 cancer cells
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = tissue of origin: Ovarian cancer
!Sample_characteristics_ch1 = cell line: epithelial ovarian cancer cell line A2780
!Sample_characteristics_ch1 = stress: Hypoxia
!Sample_characteristics_ch1 = time: 48hr
!Sample_treatment_protocol_ch1 = Cells  incubated in an oxygen-controlled hypoxia chamber at 1% O2 for 6hr, 48hr, 6days.
!Sample_growth_protocol_ch1 = Cells were maintained in 5% CO2 at 37°C in RPMI 1640 supplemented with 10-15% fetal bovine serum (FBS) and 0.1% gentamicin sulfate. For Hypoxia treatments, cells were incubated in an oxygen-controlled hypoxia chamber at 1% O2 for respective treatment intervals.
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = RNA was isolated using miRVANA RNA isolation kit (Lifetechnologies). RNA qulaity was meassured using Agilent Bioanalyzer, with atleast RIN<8.
!Sample_extract_protocol_ch1 = Starting with 3ug of total RNA for each sample, Ribosomal RNA was depleted using Ribominus (Invitrogen/Life Technologies, Carlsbad, CA) following manufacturer's recommendations.  Sequencing libraries were then prepared and barcoded individually using  the SOLiD™ Total RNA-Seq Kit for Whole Transcriptome Libraries (Life Technologies, Inc., Carlsbad, CA) following manufacturer's recommendations. Prepared samples were then pooled and sequenced using the Life Technology 5500xl sequencer using 75 base forward read only.
