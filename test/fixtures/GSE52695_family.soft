^SERIES = GSE52695
!Series_title = RNA-seq analysis of Hypoxia and Normoxia cultured cancer cells
!Series_geo_accession = GSE52695
!Series_status = Public on Oct 20 2016
!Series_submission_date = Nov 25 2013
!Series_last_update_date = May 15 2019
!Series_pubmed_id = 25351346
!Series_summary = Purpose: To study differential mRNA and precursor miRNA expression under hypoxia exposure in cancer cells. We treated ovarian cancer cell line A2780 under hypoxia condition at different time points. Normoxi acultured cells at corresponding time point were used as controls.
!Series_overall_design = A2780 cancer cells, cultured under hypoxia and normoxia. Time points tested: 6hr, 48hr, 6days.
!Series_type = Expression profiling by high throughput sequencing
!Series_type = Non-coding RNA profiling by high throughput sequencing
!Series_contributor = Anil,K,Sood
!Series_contributor = Rajesha,,Rupaimoole
